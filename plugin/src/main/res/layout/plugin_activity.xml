<?xml version="1.0" encoding="utf-8"?>
<!-- 插件里的 XML 布局：验证资源热更新（布局 + 颜色 + 字符串 + drawable 本地图） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/plugin_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:id="@+id/iv_plugin_logo"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:contentDescription="@string/plugin_logo_desc"
        android:src="@drawable/plugin_icon" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/plugin_title"
        android:textColor="@color/plugin_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_plugin_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/plugin_version_placeholder"
        android:textColor="@color/plugin_text"
        android:textSize="16sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/plugin_hint"
        android:textColor="@color/plugin_text"
        android:textSize="14sp" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  宿主（母体）AndroidManifest。
  插件资源用 packageId 0x80 隔离，宿主（接入方）可以自由使用 0x7f 资源，两者不会冲突。
  当前 demo 为求极简仍用系统 theme、无 icon/label；真实接入方 App 可正常带资源。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name="com.plugin.sdk.demo.HostApplication"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- 宿主入口（空壳，仅用于启动/加载插件） -->
        <activity
            android:name="com.plugin.sdk.demo.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 宿主占位 Activity：承载插件里的「Activity」，生命周期转发给插件 -->
        <activity
            android:name="com.plugin.sdk.activity.HostProxyActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar" />

    </application>

</manifest>
